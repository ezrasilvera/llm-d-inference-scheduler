        <mxCell id="b3" value="g.Add(&quot;pollers&quot;, dlRuntime.StartPollers)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1225"/><mxPoint x="265" y="1225"/></Array></mxGeometry></mxCell>
