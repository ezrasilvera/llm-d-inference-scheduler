        <mxCell id="b10" value="fsnotify.NewWatcher() + watcher.Add(path)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1475"/><mxPoint x="1100" y="1475"/></Array></mxGeometry></mxCell>

