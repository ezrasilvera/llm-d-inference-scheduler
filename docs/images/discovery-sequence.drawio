        <mxCell id="b6" value="load(ctx, notifier)  [initial load]" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1320"/><mxPoint x="430" y="1320"/></Array></mxGeometry></mxCell>
        <mxCell id="b7" value="os.ReadFile(path)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1345"/><mxPoint x="1270" y="1345"/></Array></mxGeometry></mxCell>
        <mxCell id="b8" value="[for each endpoint in file]  notifier.Upsert(meta)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#d79b00;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1370"/><mxPoint x="595" y="1370"/></Array></mxGeometry></mxCell>
        <mxCell id="b9" value="ds.BackendUpsert(ctx, meta)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="1395"/><mxPoint x="760" y="1395"/></Array></mxGeometry></mxCell>
        <mxCell id="b9b" value="epf.NewEndpoint -- starts metrics poller" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="1420"/><mxPoint x="930" y="1420"/></Array></mxGeometry></mxCell>

        <!-- watchFile branch -->
