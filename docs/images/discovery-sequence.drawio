        <mxCell id="b11" value="watcher.Events (Write/Create)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1520"/><mxPoint x="430" y="1520"/></Array></mxGeometry></mxCell>
        <mxCell id="b12" value="load(ctx, notifier)  [reload]" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1545"/><mxPoint x="430" y="1545"/></Array></mxGeometry></mxCell>
        <mxCell id="b13" value="notifier.Upsert(new/changed)  +  notifier.Delete(removed)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#d79b00;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="1565"/><mxPoint x="595" y="1565"/></Array></mxGeometry></mxCell>

