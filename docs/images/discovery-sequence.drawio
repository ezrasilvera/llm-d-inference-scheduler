        <mxCell id="bsep1" value="-- goroutines start --" style="text;fontStyle=2;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="1265" width="500" height="20" as="geometry"/></mxCell>

        <!-- disc.Start -->
